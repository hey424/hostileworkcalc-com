---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Contact | hostileworkcalc.com';
const description = 'Contact the editorial team at hostileworkcalc.com for corrections, feedback, or questions.';
---
<BaseLayout title={title} description={description}>
  <h1>Contact</h1>
  <p>For corrections, feedback, or questions about the site, email <a href="mailto:hey@theclicklab.agency">hey@theclicklab.agency</a>.</p>
  <p>We read every message and respond to factual correction reports promptly. We cannot provide legal advice or respond to requests for case-specific analysis — if you need guidance about a harassment situation, please consult a licensed employment attorney. Most offer free initial consultations and take Title VII cases on contingency.</p>
  <p>If you are experiencing ongoing harassment and are concerned about EEOC deadlines, do not wait for a response from us — file an EEOC charge at <a href="https://www.eeoc.gov" target="_blank" rel="noopener">eeoc.gov</a> or call 1-800-669-4000 to preserve your filing date.</p>
</BaseLayout>

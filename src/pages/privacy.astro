---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Privacy Policy | hostileworkcalc.com';
const description = 'Privacy policy for hostileworkcalc.com — data collection, cookies, third-party services, and your choices.';
---
<BaseLayout title={title} description={description}>
  <h1>Privacy Policy</h1>
  <p><strong>Effective date:</strong> January 1, 2026</p>

  <h2>Information We Collect</h2>
  <p>hostileworkcalc.com does not collect personal information directly from visitors. We do not require account registration, and calculator inputs run locally in your browser and are not transmitted to any server.</p>
  <p>We use Google AdSense and Google Analytics. Both services collect usage data as described in Google&rsquo;s privacy policy. Google AdSense may use cookies and device identifiers to serve interest-based advertising.</p>

  <h2>Cookies</h2>
  <p>Cookies on this site are placed by Google AdSense (advertising) and Google Analytics (aggregate traffic measurement). We do not place first-party tracking or advertising cookies. You can opt out of personalized Google advertising at <a href="https://adssettings.google.com" target="_blank" rel="noopener">Google Ad Settings</a>.</p>

  <h2>Third-Party Services</h2>
  <ul>
    <li><strong>Google AdSense</strong> — display advertising. Subject to <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Google&rsquo;s Privacy Policy</a>.</li>
    <li><strong>Google Analytics</strong> — aggregate traffic analysis. We do not use it to identify individual visitors.</li>
  </ul>

  <h2>Children&rsquo;s Privacy</h2>
  <p>This site is not directed to children under 13 and we do not knowingly collect information from children.</p>

  <h2>Changes</h2>
  <p>We may update this policy to reflect changes in our practices or applicable law. The effective date will be updated when changes are made.</p>

  <h2>Contact</h2>
  <p>Questions? Email <a href="mailto:hey@theclicklab.agency">hey@theclicklab.agency</a>.</p>
</BaseLayout>
